# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic (Claude) - server-side only (REQUIRED)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional model overrides
# ANTHROPIC_ANSWER_MODEL=claude-sonnet-5-5
# ANTHROPIC_REPAIR_MODEL=claude-haiku-5-5

# OpenAI (embeddings) - server-side only
OPENAI_API_KEY=your-openai-api-key

# Admin bearer token for /api/health/deep and /api/kb/embed (16+ random characters)
ADMIN_API_KEY=generate-a-long-random-value

# Signs the chat session cookie (recommended; falls back to the service-role key)
SESSION_SECRET=generate-a-long-random-value

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
