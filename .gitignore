# Dependencies
node_modules/

# Environment variables — ignore every .env* except the committed example.
# The old patterns missed .env.production / .env.development (AG-SEC-11).
.env*
!.env.example

# Keys and credentials
*.pem
*.p8
*.p12
*.key
*credentials*
*service-account*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build output
dist/
build/
out/
.next/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# Supabase local
supabase/.temp/

# Python (if backend scripts)
__pycache__/
*.pyc
.venv/
frontend/.env.vercel
